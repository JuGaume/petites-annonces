{
  // À placer dans .vscode/tasks.json à la racine du projet petites-annonces
  // Usage : Ctrl+Shift+B (ou palette de commandes → "Tasks: Run Build Task")
  // → lance l'API .NET et le front Vite en parallèle, chacun dans son panneau
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: dotnet run",
      "type": "shell",
      "command": "dotnet",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}/api/PetitesAnnonces.Api"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          // Ces 2 lignes détectent le démarrage/fin d'un cycle de build dotnet
          "beginsPattern": ".*",
          "endsPattern": "Now listening on:|Application started"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "clear": true
      }
    },
    {
      "label": "Front: npm run dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in|Local:"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "clear": true
      }
    },
    {
      "label": "Front: npm install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Dev: API + Front",
      "dependsOrder": "parallel",
      "dependsOn": ["API: dotnet run", "Front: npm run dev"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Install + API + Front",
      "dependsOrder": "sequence",
      "dependsOn": ["Front: npm install", "Dev: API + Front"],
      "problemMatcher": []
    }
  ]
}
